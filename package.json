{
  "name": "pear-make",
  "version": "0.0.0-rc.0",
  "description": "Pear CLI app for building Pear CLI apps.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": {
    "production": "pear://TODO",
    "stage": "pear://m897mcrjujjk9hbcs18qf8yz993wkyhguttoxu8fre1qtd9dy3uo",
    "dev": "pear://m9b5fx8druw5rpdoq8s4583ecuw5btwg5rxra93nwcy414ptt74y"
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --standalone --host darwin-arm64 --out ./out/make bin.mjs",
    "make:darwin-x64": "bare-build --standalone --host darwin-x64 --out ./out/make bin.mjs",
    "make:linux-arm64": "bare-build --standalone --host linux-arm64 --out ./out/make bin.mjs",
    "make:linux-x64": "bare-build --standalone --host linux-x64 --out ./out/make bin.mjs",
    "make:win32-arm64": "bare-build --standalone --host win32-arm64 --out ./out/make bin.mjs",
    "make:win32-x64": "bare-build --standalone --host win32-x64 --out ./out/make bin.mjs"
  },
  "dependencies": {
    "bare-build": "^1.4.0",
    "bare-console": "^6.2.0",
    "bare-daemon": "^1.2.4",
    "bare-file-logger": "^1.2.1",
    "bare-fs": "^4.7.2",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "fs-native-extensions": "^1.5.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.1.4",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-runtime": "^1.34.1",
    "bare-subprocess": "^6.2.2",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/pear-make.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-make/issues"
  }
}
